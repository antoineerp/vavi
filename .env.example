# Le projet Supabase de vavi (région Europe). Les vraies valeurs vont dans les secrets, jamais dans le dépôt.
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Côté serveur seulement.
SUPABASE_SERVICE_ROLE_KEY=
# L'adresse de la plateforme.
NEXT_PUBLIC_APP_URL=https://nouveau.vavi.dev

# Le magasin des builds : tout stockage compatible S3 (Object Storage d'OVH, Tigris…)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Où les paquets des apps s'installent une fois par verrou (posé d'avance par lib/atelier/prechauffer.ts)
VAVI_DEPENDANCES_DES_APPS=
